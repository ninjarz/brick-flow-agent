{
  "name": "brick-flow-agent",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost playwright test",
    "audit:ldraw": "node scripts/audit-ldraw-coverage.mjs",
    "audit:obj-connectivity": "node scripts/audit-obj-connectivity.mjs",
    "download:ldraw": "node scripts/download-ldraw-parts.mjs",
    "generate:part-colors": "node scripts/generate-official-part-colors.mjs",
    "generate:ldraw": "node scripts/generate-ldraw-structural.mjs",
    "generate:obj": "node scripts/generate-obj-assets.mjs",
    "profile:performance": "node scripts/profile-performance.mjs",
    "check:performance": "node scripts/profile-performance.mjs --check",
    "verify:release": "npm run verify:quality && npm run check:performance",
    "validate:builds": "node scripts/validate-builds.mjs",
    "verify:replicas": "python3 scripts/verify-lego-replicas.py",
    "preview": "vite preview",
    "test:production": "NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost playwright test --config=playwright.production.config.ts",
    "verify:quality": "npm run lint && npm run build && npm test && npm run test:e2e && npm run test:production && npm run validate:builds && npm run verify:replicas && npm run audit:ldraw && npm run audit:obj-connectivity"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.168.0",
    "three-bvh-csg": "0.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
